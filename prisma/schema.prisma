generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DEMO
}

enum ItemKind {
  PRODUCT
  SERVICE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          String   @id
  name        String
  price       Int
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Availability {
  id        String   @id @default(cuid())
  date      DateTime
  time      String
  available Boolean  @default(true)
  note      String?

  @@unique([date, time])
}

model Booking {
  id           String        @id @default(cuid())
  reference    String        @unique
  slotKey      String        @unique
  scheduledAt  DateTime
  serviceIds   String[]
  vehicleBrand String
  vehicleModel String
  customerName String
  phone        String
  email        String
  notes        String?
  status       BookingStatus @default(PENDING)
  emailStatus  String        @default("NOT_CONFIGURED")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Product {
  id          String   @id
  name        String
  description String
  category    String
  price       Int
  stock       Int      @default(0)
  active      Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique
  email           String
  customerName    String
  phone           String
  status          OrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  shippingMethod  String?
  shippingPrice   Int           @default(0)
  shippingAddress Json?
  pickupPoint     Json?
  subtotal        Int
  total           Int
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId String
  name       String
  kind       ItemKind
  unitPrice  Int
  quantity   Int
}

model ShippingRate {
  id     String  @id
  name   String
  price  Int
  active Boolean @default(true)
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String
  category  String
  beforeUrl String?
  afterUrl  String
  alt       String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}
