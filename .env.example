# PostgreSQL — wymagane do rezerwacji, zamówień i panelu administracyjnego
DATABASE_URL="postgresql://apexdetail:apexdetail@localhost:5432/apexdetail?schema=public"

# Stripe — brak kluczy uruchamia jawny tryb demonstracyjny bez obciążenia karty
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps — klucz ograniczony do domeny produkcyjnej
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Oficjalny proxy/API operatora punktów odbioru (np. ShipX po zawarciu umowy)
PICKUP_PROVIDER_API_URL=""
PICKUP_PROVIDER_TOKEN=""

# Dostawca e-mail zgodny z prostym endpointem HTTP
EMAIL_API_URL=""
EMAIL_API_TOKEN=""
EMAIL_FROM="ApexDetail <rezerwacje@example.com>"

# Sesja administratora; w produkcji wygeneruj długi losowy sekret
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""
